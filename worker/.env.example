# worker 환경변수 예시 — 실제 값은 worker/.env 에 두고 커밋하지 않는다.
# Supabase/Postgres 연결 문자열 (pg-boss 가 잡 큐 스키마를 이 DB에 생성)
DATABASE_URL=

# BBE-30: moawork_outbox_worker 전용 연결 문자열. DATABASE_URL/service role을 재사용하지 않는다.
OUTBOX_DATABASE_URL=
OUTBOX_WORKER_ID=
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=60000
OUTBOX_SENDS_PER_SECOND=10
OUTBOX_MAX_ATTEMPTS=5

# BBE-114 provider adapter credentials (실제 값은 운영 비밀로만 주입)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
