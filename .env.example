# moawork 환경변수 — 형태만 남긴다. 실제 값은 .env.local 에 두고 커밋하지 않는다.
#
# 아래 두 값이 모두 채워지면 core.crm 이 Supabase 를 보고,
# 비어 있으면 로컬 인메모리 데이터로 폴백한다(연결 전에도 화면이 그대로 동작).

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(공개) 키. RLS 를 전제로 하는 클라이언트 키다.
# service-role 키는 여기에도, 저장소 어디에도 두지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 분석 · PostHog (C5) ──────────────────────────────────────────────────
# 아래 KEY 가 비었거나 형태가 어긋나면 분석은 **완전히 꺼진다**(SDK 로드도 안 한다).
# 실제 값은 app/.env.local 에만 두고 커밋·로그·문서에 남기지 않는다.

# 프로젝트 공개 키. 형태: phc_ + 영숫자 20자 이상.
# 개인 API 키(phx_/phs_)나 서버 키는 절대 여기에 넣지 않는다 — 브라우저에 노출된다.
NEXT_PUBLIC_POSTHOG_KEY=
# 수집 호스트는 코드에서 PostHog US 리전으로 고정되며 환경변수로 바꿀 수 없다.

# (선택) 빌드 버전 — 이벤트 필수 속성 app_version 의 값.
# 미설정이면 "dev". Vercel 이면 프로젝트 환경변수에서 커밋 SHA 를 연결한다:
#   NEXT_PUBLIC_APP_VERSION = $VERCEL_GIT_COMMIT_SHA   (40자 전체 SHA를 그대로 사용한다)
NEXT_PUBLIC_APP_VERSION=

# ── 릴리스 연속성 · 자체 호스팅 (#725) ────────────────────────────────────
# Next Server Action과 5분 첨부 다운로드 토큰을 Vercel↔VPS, blue↔green에서
# 같은 키로 검증한다. canonical base64로 인코딩한 AES 키 16/24/32바이트만 허용한다.
# 실제 값은 Vercel과 자체 호스팅의 비밀 저장소에 각각 주입하고 절대 커밋하지 않는다.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# 아래 두 값은 비밀이 아닌 40자 Git SHA다. 자체 호스팅 빌드/기동 스크립트가
# 각각 산출물의 실제 revision과 이번에 활성화할 revision으로 주입한다.
MOAWORK_BUILD_SHA=
MOAWORK_RELEASE_SHA=
# 배포 제어기가 검증한 불변 source/standalone bundle의 SHA-256(소문자 64자리).
# health의 `artifact=verified`는 이 값만으로 신뢰하지 않고 배포 영수증과 함께 판정한다.
MOAWORK_ARTIFACT_SHA256=

# ── 플랫폼 지표 야간 배치 (C4 · T04) ──────────────────────────────────────
# /api/cron/platform-metrics 가 참조한다. 둘 다 채워져야 배치가 동작하며,
# 비면 엔드포인트는 501(환경 미설정)로 응답한다.

# Cron 인증 시크릿. Vercel Cron 이 Authorization: Bearer <값> 으로 보낸다.
# 미설정이면 엔드포인트는 503 으로 **거부**한다(인증 없이 열어두지 않는다).
CRON_SECRET=

# Supabase service-role 키 — 배치가 전 조직을 훑기 위해 필요하다.
# ⚠ 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 유출되므로 절대 금지.
# ⚠ 실제 값은 .env.local 또는 Vercel 환경변수로만 주입하고 저장소에 두지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 모드 선택(관리자/사용자) 서명 (BBE-70) ─────────────────────────────────
# app/src/app/mode/** 가 참조한다. 로그인 직후 "관리자 페이지 열기 / 회사 업무로
# 가기"를 고르면 그 선택을 쿠키(mw_mode)에 서명해 기억해 둔다 — 선택 자체는
# 권한이 아니고(재검증은 매번 다시 한다), 다음 로그인 때 다시 묻지 않으려는
# 편의 기능이다.
#
# 비어 있으면 서명이 불가능해 "관리자 페이지 열기" 클릭이 사람이 읽을 수
# 있는 안내 화면(/mode?error=config)으로 돌아간다 — 예전엔 raw JSON 400 이었다.

# 임의의 32자 이상 문자열. 생성 예: openssl rand -base64 32
MOAWORK_MODE_PREFERENCE_SECRET=

# ── RLS 침투 테스트 (T10) ────────────────────────────────────────────────
# app/src/lib/auth/rls-penetration.test.ts 가 참조한다.
# 위 URL/ANON_KEY 와 아래 3개가 **모두** 채워져야 테스트가 실행된다.
# 하나라도 비면 테스트는 조용히 skip 되고 "RLS 미검증" 상태가 유지된다.

# 조직 A 소속 사용자 (로그인해 access_token 을 받아 auth.uid() 를 채운다)
RLS_TEST_ORG_A_EMAIL=
RLS_TEST_ORG_A_PASSWORD=

# 조직 B 의 org uuid — 조직 A 세션으로 접근 시 0행이어야 한다
RLS_TEST_ORG_B_ID=

# (선택) scope='assigned' 멤버 — 담당범위 격리 케이스에서만 쓰인다.
# 비워도 위 3개가 있으면 조직격리 검증은 실행된다.
RLS_TEST_MEMBER_EMAIL=
RLS_TEST_MEMBER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 작업 대시보드 (tools/dashboard-server.mjs) — 2026-08-11
# Linear 개인 API 키. 대시보드가 카드·PR·도장을 읽어오는 데 쓴다.
# 만드는 곳: https://linear.app/settings/account/security
#   → API keys → New API key → 권한은 «Read» 만 · 팀은 Bbelieff 만
# ⚠️ 이 파일(.env.example)에는 «형태» 만 적는다. 실제 값은 .env 에 넣는다.
#    .env 는 .gitignore 69~71줄이 막고 있어 저장소에 안 올라간다.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 대시보드 서버가 들을 포트 (기본 8787)
DASHBOARD_PORT=8787
