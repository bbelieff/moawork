# moawork 환경변수 — 형태만 남긴다. 실제 값은 .env.local 에 두고 커밋하지 않는다.
#
# 아래 두 값이 모두 채워지면 core.crm 이 Supabase 를 보고,
# 비어 있으면 로컬 인메모리 데이터로 폴백한다(연결 전에도 화면이 그대로 동작).

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(공개) 키. RLS 를 전제로 하는 클라이언트 키다.
# service-role 키는 여기에도, 저장소 어디에도 두지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 분석 · PostHog (C5) ──────────────────────────────────────────────────
# 아래 KEY 가 비었거나 형태가 어긋나면 분석은 **완전히 꺼진다**(SDK 로드도 안 한다).
# 실제 값은 app/.env.local 에만 두고 커밋·로그·문서에 남기지 않는다.

# 프로젝트 공개 키. 형태: phc_ + 영숫자 20자 이상.
# 개인 API 키(phx_/phs_)나 서버 키는 절대 여기에 넣지 않는다 — 브라우저에 노출된다.
NEXT_PUBLIC_POSTHOG_KEY=

# (선택) 수집 호스트. 비우면 https://us.i.posthog.com.
# EU 프로젝트면 https://eu.i.posthog.com, 자체 호스팅이면 그 https 주소.
# 이벤트는 항상 자기 도메인의 /ingest 로 나가고, 이 값은 rewrites 의 목적지로만 쓰인다.
NEXT_PUBLIC_POSTHOG_HOST=

# ── 플랫폼 지표 야간 배치 (C4 · T04) ──────────────────────────────────────
# /api/cron/platform-metrics 가 참조한다. 둘 다 채워져야 배치가 동작하며,
# 비면 엔드포인트는 501(환경 미설정)로 응답한다.

# Cron 인증 시크릿. Vercel Cron 이 Authorization: Bearer <값> 으로 보낸다.
# 미설정이면 엔드포인트는 503 으로 **거부**한다(인증 없이 열어두지 않는다).
CRON_SECRET=

# Supabase service-role 키 — 배치가 전 조직을 훑기 위해 필요하다.
# ⚠ 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 유출되므로 절대 금지.
# ⚠ 실제 값은 .env.local 또는 Vercel 환경변수로만 주입하고 저장소에 두지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── RLS 침투 테스트 (T10) ────────────────────────────────────────────────
# app/src/lib/auth/rls-penetration.test.ts 가 참조한다.
# 위 URL/ANON_KEY 와 아래 3개가 **모두** 채워져야 테스트가 실행된다.
# 하나라도 비면 테스트는 조용히 skip 되고 "RLS 미검증" 상태가 유지된다.

# 조직 A 소속 사용자 (로그인해 access_token 을 받아 auth.uid() 를 채운다)
RLS_TEST_ORG_A_EMAIL=
RLS_TEST_ORG_A_PASSWORD=

# 조직 B 의 org uuid — 조직 A 세션으로 접근 시 0행이어야 한다
RLS_TEST_ORG_B_ID=

# (선택) scope='assigned' 멤버 — 담당범위 격리 케이스에서만 쓰인다.
# 비워도 위 3개가 있으면 조직격리 검증은 실행된다.
RLS_TEST_MEMBER_EMAIL=
RLS_TEST_MEMBER_PASSWORD=
