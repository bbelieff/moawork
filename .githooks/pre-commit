#!/usr/bin/env bash
# moawork pre-commit 훅 — 커밋 전에 exact staged-tree fast gate를 실행한다.
# 활성화: git config core.hooksPath .githooks  (루트 `npm install` 시 자동 설정됨)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
echo "🔎 pre-commit: exact staged-tree fast gate 실행 (일반 < 2분, guardian 변경 검사 < 5분)…"
node "$ROOT/scripts/ci/fast-staged.mjs"
